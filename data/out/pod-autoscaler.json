{
  "apiVersion": "autoscaling/v2",
  "kind": "HorizontalPodAutoscaler",
  "metadata": {
    "name": "api-server-hpa",
    "namespace": "production"
  },
  "spec": {
    "behavior": {
      "scaleDown": {
        "policies": [
          {
            "periodSeconds": 120,
            "type": "Pods",
            "value": 1
          }
        ],
        "stabilizationWindowSeconds": 300
      },
      "scaleUp": {
        "policies": [
          {
            "periodSeconds": 60,
            "type": "Pods",
            "value": 2
          }
        ],
        "stabilizationWindowSeconds": 60
      }
    },
    "maxReplicas": 12,
    "metrics": [
      {
        "resource": {
          "name": "cpu",
          "target": {
            "averageUtilization": 70,
            "type": "Utilization"
          }
        },
        "type": "Resource"
      },
      {
        "resource": {
          "name": "memory",
          "target": {
            "averageUtilization": 80,
            "type": "Utilization"
          }
        },
        "type": "Resource"
      }
    ],
    "minReplicas": 3,
    "scaleTargetRef": {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "name": "api-server"
    }
  }
}